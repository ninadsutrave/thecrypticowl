# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Analytics ─────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
VITE_GA_ID=G-XXXXXXXXXX

# ── Lambda providers (set as GitHub Actions secrets / repo variables) ────────
# AI_PROVIDER selects the clue setter, JUDGE_PROVIDER the reviewer. Leave
# JUDGE_PROVIDER unset to use the same provider for both. Running two different
# model families means setter and reviewer don't share a blind spot.
#
# AI_PROVIDER=gemini          # gemini | openai | claude | deepseek | grok | mistral
# JUDGE_PROVIDER=gemini
#
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# DEEPSEEK_API_KEY=...
# XAI_API_KEY=...
# MISTRAL_API_KEY=...
#
# SUPABASE_URL=...                  # server-side; NOT the VITE_ one
# SUPABASE_SERVICE_ROLE_KEY=...     # never expose to the frontend

# ── AWS (set as GitHub Actions secrets, not in .env) ──────────────────────────
# These are used only in CI/CD — never commit real AWS credentials.
#
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=crypticowl-prod
# CLOUDFRONT_DISTRIBUTION_ID=EXXXXXXXXX
# LAMBDA_FUNCTION_NAME=crypticowl-daily   # the cryptic Lambda's existing name
# LAMBDA_ROLE_ARN=arn:aws:iam::...:role/...  # shared by every game Lambda
#
# ── Per-game Lambdas (repo variables; see docs/lambdas.md) ────────────────────
# LAMBDA_NAME_PREFIX=crypticowl   # functions are <prefix>-<game>
# CONTACT_EMAIL=you@example.com   # sent in the User-Agent; Wikimedia requires it
# PUZZLE_DAYS_AHEAD=3             # buffer of days generated ahead (0–14)
#
# Schedules (EventBridge expressions, UTC). Defaults stagger 03:00–03:35:
# LAMBDA_SCHEDULE=cron(15 3 * * ? *)       # cryptic (original variable)
# SUDOKU_SCHEDULE=cron(0 3 * * ? *)
# CHRONOLOGY_SCHEDULE=cron(5 3 * * ? *)
# CHESS_SCHEDULE=cron(10 3 * * ? *)
# CRYPTOGRAM_SCHEDULE=cron(20 3 * * ? *)
# WHAT_AM_I_SCHEDULE=cron(25 3 * * ? *)
# TRIVIA_SCHEDULE=cron(35 3 * * ? *)
