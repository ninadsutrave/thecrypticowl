{
  "name": "thecrypticowl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src lambda --max-warnings 0",
    "lint:fix": "eslint src lambda --fix",
    "format": "prettier --write src lambda",
    "format:check": "prettier --check src lambda",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "canvas-confetti": "1.9.4",
    "chess.js": "^1.4.0",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.18.3",
    "recharts": "2.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "6.3.5",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.x"
  }
}
